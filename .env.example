# Copy to .env. Next and all npm CLIs read it. Never commit the populated file.
NEBRASKA_MODE=demo
APP_URL=http://localhost:3000
# Omit DATABASE_URL for embedded SQLite. Modes use separate local databases.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nebraska
# SQLITE_PATH=data/demo.db
# For Postgres endpoints that require verified TLS:
# PGSSL=true

# Required in sandbox. Generate independent random values with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_API_TOKEN=

# Sandbox-only demo aid: shorten the 14-day claim/email/host cooldown to N minutes.
# Ignored unless NEBRASKA_MODE=sandbox. Reported as demoOverrides on GET /api/health,
# and the UI shows a permanent "Demo: cooldown shortened" badge. Leave empty for judging data.
# DEMO_COOLDOWN_MINUTES=

# Sandbox only; the PayPal adapter cannot target live endpoints.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# GitHub OAuth callback: APP_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Structured decision provider + bounded tool-calling Treasurer.
# Any OpenAI-compatible chat-completions endpoint. Default: OpenAI.
# OpenCode Zen example: MODEL_BASE_URL=https://opencode.ai/zen/v1, DECISION_MODEL=deepseek-v4.1-flash
# MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# OPENAI_API_KEY is still accepted when MODEL_API_KEY is empty.
OPENAI_API_KEY=
DECISION_MODEL=gpt-4.1-2025-04-14
TREASURER_MODEL=gpt-4.1-2025-04-14
# agent = LLM tool loop when credentials available; workflow = deterministic orchestration.
TREASURER_MODE=agent

# CI/hooks/MCP client environment (not needed by the web server).
NEBRASKA_URL=http://localhost:3000
NEBRASKA_ORG_ID=org_acme
NEBRASKA_API_TOKEN=
NEBRASKA_REPO_SALT=
# Optional canonical repo identity; otherwise normalized git origin is used.
# Set a stable identity when the repository has no origin.
NEBRASKA_REPO_ID=

# Optional read-only reporting cross-check via official PayPal Agent Toolkit.
# Default launches scripts/toolkit-mcp.ts and exposes only transactions.list.
PAYPAL_TOOLKIT_REPORT_TOOL=list_transactions
# PAYPAL_TOOLKIT_URL=https://YOUR_READ_ONLY_MCP_SERVER/mcp
# PAYPAL_TOOLKIT_TOKEN=
# PAYPAL_TOOLKIT_COMMAND=node
# PAYPAL_TOOLKIT_ARGS=["--import","tsx","scripts/toolkit-mcp.ts"]
RECONCILE_WITH_TOOLKIT=false
# Override only for an intentional manual month-end run:
# SETTLEMENT_PERIOD=2026-11

# Managed environments: enable Node's inherited HTTP(S) proxy handling if needed.
# NODE_USE_ENV_PROXY=1
