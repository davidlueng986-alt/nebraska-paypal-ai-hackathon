{
  "name": "Nebraska — plain",
  "version": "2.0.0",
  "notes": "Plain, tool-like interface in the spirit of developer tools: white surfaces, hairline borders, system fonts, one meaning per color. No decorative type, no gradients, no dark room. All text colors pass WCAG AA on bg and bg-subtle.",
  "color": {
    "bg": "#FFFFFF",
    "bg-subtle": "#F6F8FA",
    "bg-inset": "#EFF2F5",
    "border": "#D1D9E0",
    "border-muted": "#E4E9EE",
    "fg": "#1F2328",
    "fg-muted": "#59636E",
    "link": "#0969DA",
    "success": "#1A7F37",
    "success-bg": "#DAFBE1",
    "success-emphasis": "#1F883D",
    "attention": "#9A6700",
    "attention-bg": "#FFF8C5",
    "danger": "#D1242F",
    "danger-bg": "#FFEBE9",
    "neutral-bg": "#EFF2F5",
    "focus": "#0969DA",
    "series": ["#1A7F37", "#0969DA", "#8250DF", "#BF8700", "#59636E", "#CF222E"]
  },
  "meaning": {
    "success": "paid, passed, verified",
    "attention": "held, waiting for a human, simulated",
    "danger": "rejected by the gate",
    "link": "navigation only"
  },
  "font": {
    "ui": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "licenses": "System fonts only; nothing is bundled."
  },
  "type": {
    "title": { "size": 24, "weight": 600, "lineHeight": 1.25 },
    "stat": { "size": 28, "weight": 600, "lineHeight": 1.2, "numeric": "tabular-nums" },
    "h2": { "size": 16, "weight": 600, "lineHeight": 1.5 },
    "body": { "size": 14, "weight": 400, "lineHeight": 1.5 },
    "small": { "size": 12, "weight": 400, "lineHeight": 1.5 },
    "mono": { "size": 13, "lineHeight": 1.5 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 40 },
  "layout": { "maxWidth": 1280, "margin": { "desktop": 32, "mobile": 16 }, "header": 56 },
  "radius": { "box": 6, "control": 6, "pill": 999 },
  "motion": { "duration": { "fast": 80, "base": 160 }, "easing": "ease-out", "reducedMotion": "no motion" },
  "identity": {
    "treasurer": { "label": "Treasurer", "icon": "bot", "meaning": "the AI did this; always shown with its gate result" },
    "you": { "label": "You", "icon": "user", "meaning": "a human did this, on PayPal" },
    "gate": { "label": "Gate", "icon": "shield-check", "meaning": "deterministic code enforcing I1–I7" },
    "paypal": { "label": "PayPal", "icon": "landmark", "meaning": "the payment provider's response" }
  }
}
